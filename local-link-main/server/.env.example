# ==================== Server Configuration ====================

# Environment
NODE_ENV=development

# Server Port
PORT=5000

# ==================== Database Configuration ====================

# MongoDB Connection String (Update with your MongoDB URI)
# Example: mongodb://localhost:27017/local-link
# Example: mongodb+srv://username:password@cluster.mongodb.net/local-link
MONGODB_URI=mongodb://localhost:27017/local-link

# ==================== JWT Configuration ====================

# JWT Secret (Generate a strong random string for production)
# Example: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Expiration
JWT_EXPIRE=30d

# JWT Issuer
JWT_ISSUER=local-link-api

# ==================== Security Configuration ====================

# Bcrypt Rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# ==================== Logging Configuration ====================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# ==================== API Configuration ====================

# API Prefix
API_PREFIX=/api

# ==================== Email Configuration (Future) ====================

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ==================== File Upload Configuration ====================

# MAX_FILE_SIZE=5242880
# UPLOAD_PATH=./uploads

# ==================== Payment Configuration (Future) ====================

# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
