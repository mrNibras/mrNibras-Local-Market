# ==================== Server Configuration ====================

# Environment
NODE_ENV=development

# Server Port
PORT=5000

# ==================== Database Configuration ====================

# MongoDB Connection String (Update with your MongoDB URI)
# Example: mongodb://localhost:27017/local-link
# Example: mongodb+srv://username:password@cluster.mongodb.net/local-link
MONGODB_URI=mongodb+srv://ramesh:ramesh1359@cluster0.whiplmn.mongodb.net/local-link?appName=Cluster0


# ==================== JWT Configuration ====================

# JWT Secret (Generate a strong random string for production)
# Example: openssl rand -base64 32
JWT_SECRET=Xjyxaw1mnpQpUZJxhRj9NnFJg3RpF37x4x1R3dmQ4YpcLzGTKeoJa9pp+Z74CsUL
PyRFcaDbPp9I9HpmnsDsxA==

# JWT Expiration
JWT_EXPIRE=30d

# JWT Issuer
JWT_ISSUER=local-link-api

# ==================== Security Configuration ====================

# Bcrypt Rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# ==================== Logging Configuration ====================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# ==================== API Configuration ====================

# API Prefix
API_PREFIX=/api

# ==================== Payment Configuration ====================

# Stripe API Keys (Get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ==================== Email Configuration ====================

# SMTP Settings (for sending emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=mrNibras <noreply@mrnibras.com>

