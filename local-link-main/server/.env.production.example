# ==================== Backend Environment Variables ====================
# Copy this file to .env and fill in the values

# Environment
NODE_ENV=production

# Server Port (Render will set this to 10000)
PORT=10000

# ==================== Database Configuration ====================

# MongoDB Connection String
# Get from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://ramesh:ramesh1359@cluster0.whiplmn.mongodb.net/?appName=Cluster0

# ==================== JWT Configuration ====================

# JWT Secret (generate with: openssl rand -base64 64)
JWT_SECRET=your-super-secret-jwt-key-generate-for-production

# JWT Expiration
JWT_EXPIRES_IN=7d

# ==================== Security Configuration ====================

# CORS Origin (Your Vercel frontend URL)
# After deploying frontend, update this to: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# ==================== Payment Configuration ====================

# Stripe API Keys (Get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ==================== Email Configuration ====================

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=mrNibras <noreply@mrnibras.com>
